# TLS for the proxy, the gateway and selan-keys (the admin's browser adds keys there), on the VPN address compose publishes. A private name cannot use
# HTTP-01 or TLS-ALPN, which Let's Encrypt checks from the internet, so SELAN_TLS is one of:
#   dns       Let's Encrypt over the DNS-01 challenge, with SELAN_DNS_PROVIDER and its SELAN_DNS_TOKEN
#   files     the company's own CA: ./certs/fullchain.pem and privkey.pem, valid for all three names
#   internal  Caddy's own CA, for a trial: every client has to trust it
{
	auto_https disable_redirects
	skip_install_trust
	ocsp_stapling off
}

# {env.…} is read when Caddy starts, so the token is never written into Caddy's saved config.
(tls-dns) {
	tls {
		dns {$SELAN_DNS_PROVIDER} {env.SELAN_DNS_TOKEN}
	}
}

(tls-files) {
	tls /certs/fullchain.pem /certs/privkey.pem
}

(tls-internal) {
	tls internal
}

# A request from outside ALLOWED_CIDRS is refused here, even if the port is reached.
(only-allowed) {
	@outside not remote_ip {$ALLOWED_CIDRS}
	respond @outside 403
}

{$SELAN_PROXY_HOST} {
	import tls-{$SELAN_TLS}
	import only-allowed
	# Every proxy instance by its own address, so `--scale proxy=N` spreads requests: a static `proxy:8080` keeps
	# reusing its pooled connection to whichever instance it dialed first, and the others serve nothing.
	reverse_proxy {
		dynamic a proxy 8080 {
			refresh 5s
		}
		lb_policy round_robin
		lb_try_duration 5s
	}
}

{$SELAN_GATEWAY_HOST} {
	import tls-{$SELAN_TLS}
	import only-allowed
	# Selan's load balancer's header; on an own server nobody may claim to be it.
	reverse_proxy gateway:8080 {
		header_up -X-Selan-Edge
	}
}

# Selan's screen in the admin's browser calls the admin API, on 8081; 8080, where the proxy and the gateway read
# keys with their own tokens, answers only its /readyz here.
{$SELAN_KEYS_HOST} {
	import tls-{$SELAN_TLS}
	import only-allowed
	@neither not path /readyz /selan/*
	respond @neither 404
	reverse_proxy /readyz keys:8080
	reverse_proxy /selan/* keys:8081
}
