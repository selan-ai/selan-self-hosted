# install.sh writes /opt/selan/.env (root only, mode 0600) from these. Each can also be exported
# before running it; README, "Settings". Never commit a filled-in copy.

# The proxy's name, as entered under Settings › Own servers › Add server. It resolves to the VPN address.
SELAN_PROXY_HOST='gw.example.com'
# The gateway's name; install.sh defaults it to mcp. beside the proxy's.
SELAN_GATEWAY_HOST='mcp.example.com'
# This server's address on your VPN. Caddy listens on it alone, on port 443.
SELAN_BIND_ADDR='100.64.0.10'
# internal: Caddy's own CA. files: certs/fullchain.pem and certs/privkey.pem, valid for both names.
SELAN_TLS='internal'
# Who may connect, checked by Caddy: private_ranges, or CIDRs separated by spaces.
ALLOWED_CIDRS='private_ranges'

# From Add server, used once; install.sh removes it from .env once the server has registered.
SELAN_REGISTRATION_TOKEN='selanreg_...'

# OpenBao on this server, when you have no Vault. Empty with VAULT_ADDR set.
COMPOSE_PROFILES='openbao'
# Your own Vault instead: its address, and AppRoles limited to VAULT_PREFIX (README, "Your own Vault").
# VAULT_ADDR='https://vault.example.internal:8200'
VAULT_PREFIX='kv/selan/'
# Written by install.sh for OpenBao; yours with your own Vault. The gateway's default to the proxy's.
PROXY_VAULT_ROLE_ID=''
PROXY_VAULT_SECRET_ID=''
GATEWAY_VAULT_ROLE_ID=''
GATEWAY_VAULT_SECRET_ID=''
